{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/team/contracts/task.schema.json",
  "title": "Team task",
  "description": "One assignable, verifiable unit of work on the run board. Any role in the roster may own a task; the workflow pipeline dispatches only executor tasks and reports the rest back.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "title",
    "definition_of_done",
    "write_scope",
    "verify"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "owner": {
      "type": "string",
      "enum": [
        "supervisor",
        "researcher",
        "planner",
        "executor",
        "qa",
        "security",
        "monitor"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "blocked",
        "review",
        "done",
        "dropped"
      ]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{3}$"
      }
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 240
      }
    },
    "write_scope": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 240
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "estimate_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480
    },
    "rollback": {
      "type": "string",
      "maxLength": 240
    },
    "artifact": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 400
    }
  }
}
