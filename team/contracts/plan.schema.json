{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/team/contracts/plan.schema.json",
  "title": "Team plan",
  "description": "Planner output: criteria coverage, dependency-ordered tasks, assumptions, rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "goal", "criteria", "tasks", "open_questions"],
  "properties": {
    "run": { "type": "string", "pattern": "^r-[0-9]{8}-[0-9]{4}-[a-z0-9][a-z0-9-]{2,39}$" },
    "goal": { "type": "string", "minLength": 8, "maxLength": 400 },
    "strategy": { "type": "string", "maxLength": 1200 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "verify"],
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]{1,2}$" },
          "text": { "type": "string", "minLength": 8, "maxLength": 240 },
          "verify": { "type": "string", "minLength": 8, "maxLength": 240 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "task.schema.json" }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 8, "maxLength": 240 }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 8, "maxLength": 240 }
    },
    "rollback": { "type": "string", "maxLength": 600 }
  }
}
