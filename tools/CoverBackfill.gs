function backfillCovers() {
  const start = Date.now();
  const sh = SpreadsheetApp.getActive().getSheetByName('Sheet1');
  const data = sh.getDataRange().getValues();
  const head = data[0].map(String);
  const cUpc = head.indexOf('song_upc'), cArt = head.indexOf('song_arts'), cTitle = head.indexOf('song_title');
  if (cUpc < 0 || cArt < 0) throw new Error('Could not find the song_upc or song_arts column.');
  const folders = DriveApp.getFoldersByName('Danyel OZ Song Art');
  const folder = folders.hasNext() ? folders.next() : DriveApp.createFolder('Danyel OZ Song Art');
  let saved = 0, left = 0, failed = [];
  for (let r = 1; r < data.length; r++) {
    const upc = String(data[r][cUpc]).trim(), art = String(data[r][cArt]).trim();
    if (art || !COVERS[upc]) continue;
    if (Date.now() - start > 5 * 60 * 1000) { left++; continue; }
    const title = String(data[r][cTitle] || upc);
    try {
      const res = UrlFetchApp.fetch(COVER_BASE + COVERS[upc], { muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) throw new Error('HTTP ' + res.getResponseCode());
      const name = (title + ' cover').replace(/[\\/:*?"<>|]/g, '') + '.jpg';
      const file = folder.createFile(res.getBlob().setName(name));
      try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) { failed.push(title + ' (saved, but not shared)'); }
      sh.getRange(r + 1, cArt + 1).setValue('https://drive.google.com/file/d/' + file.getId() + '/view');
      saved++;
    } catch (e) {
      failed.push(title + ': ' + e.message);
    }
  }
  SpreadsheetApp.flush();
  Logger.log('Saved ' + saved + ' covers.' + (left ? ' ' + left + ' still to go. Run it again.' : ' All done.'));
  if (failed.length) Logger.log('Problems:\n' + failed.join('\n'));
}
